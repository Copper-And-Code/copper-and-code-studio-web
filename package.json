{
  "name": "copper-and-code-studio-web",
  "version": "0.0.0",
  "private": true,
  "description": "Copper and Code Studio Web: the visual GUI builder for MicroPython and LVGL, in the browser",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "assets": "node scripts/copy-pyodide.mjs && node scripts/fetch-runtime.mjs && node scripts/bundle-upstream.mjs && node scripts/bundle-examples.mjs",
    "dev": "pnpm assets && vite",
    "build": "tsc --noEmit && pnpm assets && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "goldens": "python3 -I scripts/goldens.py",
    "test:py": "node scripts/bundle-upstream.mjs && node scripts/fetch-runtime.mjs && vitest run -c vitest.py.config.ts && node tests/py/upstream-tests.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "fflate": "0.8.3",
    "lit": "3.3.3",
    "opentype.js": "1.3.4",
    "pyodide": "314.0.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/w3c-web-serial": "1.0.8",
    "eslint": "10.14.0",
    "globals": "17.13.0",
    "lv_font_conv": "1.5.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
