{
  "name": "lvgl-mpy-studio-web",
  "version": "0.0.0",
  "private": true,
  "description": "LVGL MPY Studio in the browser",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "assets": "node scripts/copy-pyodide.mjs && node scripts/bundle-upstream.mjs && node scripts/bundle-examples.mjs",
    "dev": "pnpm assets && vite",
    "build": "tsc --noEmit && pnpm assets && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "goldens": "python3 -I scripts/goldens.py",
    "test:py": "node scripts/bundle-upstream.mjs && vitest run -c vitest.py.config.ts && node tests/py/upstream-tests.mjs",
    "e2e": "playwright test"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "lit": "3.3.3",
    "pyodide": "314.0.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
