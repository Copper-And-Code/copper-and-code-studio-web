  "code": {
    "module": "# the general code\nSPEED = 3\n",
    "handlers": {
      "tick_tick": {
        "widget": "tick",
        "event": "TICK",
        "body": "on_tick()\n"
      },
      "Menu_screen_loaded": {
        "widget": "Menu",
        "event": "SCREEN_LOADED",
        "body": "translate_once()\nbig_titles()\n"
      },
      "Game_screen_loaded": {
        "widget": "Game",
        "event": "SCREEN_LOADED",
        "body": "new_game()\n"
      },
      "Solved_screen_loaded": {
        "widget": "Solved",
        "event": "SCREEN_LOADED",
        "body": "show_result()\n"
      },
      "btn_play_clicked": {
        "widget": "btn_play",
        "event": "CLICKED",
        "body": "remember_pointer()\nplay_tone(660, 40)\nui.load_page(ui.PAGE_GAME)\n"
      },
      "btn_again_clicked": {
        "widget": "btn_again",
        "event": "CLICKED",
        "body": "remember_pointer()\nplay_tone(660, 40)\nui.load_page(ui.PAGE_GAME)\n"
      },
      "btn_options_clicked": {
        "widget": "btn_options",
        "event": "CLICKED",
        "body": "play_tone(520, 40)\nui.load_page(ui.PAGE_OPTIONS)\n"
      },
      "btn_back_clicked": {
        "widget": "btn_back",
        "event": "CLICKED",
        "body": "play_tone(520, 40)\nui.load_page(ui.PAGE_MENU)\n"
      },
      "btn_end_menu_clicked": {
        "widget": "btn_end_menu",
        "event": "CLICKED",
        "body": "play_tone(520, 40)\nui.load_page(ui.PAGE_MENU)\n"
      },
      "btn_quit_clicked": {
        "widget": "btn_quit",
        "event": "CLICKED",
        "body": "leave_game()\nplay_tone(520, 40)\nui.load_page(ui.PAGE_MENU)\n"
      },
      "opt_shuffle_value_changed": {
        "widget": "opt_shuffle",
        "event": "VALUE_CHANGED",
        "body": "set_shuffle(ui.opt_shuffle.get_value())\n"
      },
      "opt_sound_value_changed": {
        "widget": "opt_sound",
        "event": "VALUE_CHANGED",
        "body": "print(\"sound\")"
      },
      "menu_bg_clicked": {
        "widget": "menu_bg",
        "event": "CLICKED",
        "body": "ui.menu_title.set_text(\"Hello\")"
      },
      "Options_screen_loaded": {
        "widget": "Options",
        "event": "SCREEN_LOADED",
        "body": "print(\"options\")"
      }
    }
  },
