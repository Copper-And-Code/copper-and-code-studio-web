      "source": "# cac_settings: the settings that every Copper and Code app on a board shares.\n#\n# One file, cac_settings.json, in the flash: /flash/cac_settings.json on boards with a /flash\n# folder (STM32), /cac_settings.json on the others (ESP32, RP2350). The Settings app writes it;\n# boot.py, the home menu of the board and the other apps read it. It holds up to five WiFi\n# networks, and sections of other settings, such as the brightness of the display:\n#\n#     {\"version\": 1, \"wifi\": [{\"ssid\": \"Home\", \"password\": \"...\"}, ...], \"display\": {\"brightness\": 70}}\n#\n# A section \"general\" holds the language of the apps, \"en\" or \"it\": language(), translator() and\n# translate() give each app its texts in it.\n#\n# The networks are kept from the most recently used. Passwords are in clear text, like in\n# MicroPython's own examples: whoever can read the flash can read them.\n#\n# Copy the same file into every app that uses it (in the IDE: a Python module of the project).\nimport json\nimport os\nimport sys\nimport time\n\ntry:\n    import network\nexcept ImportError:                        # the simulator and the PC have no WiFi\n    network = None\n\nVERSION = 1\nMAX_NETWORKS = 5\nTIMEOUT_S = 10                             # for each network tried\nDEMO_SCAN = ((\"Home\", -48), (\"Office\", -61), (\"Guest\", -75))\n\n\ndef path():\n    \"\"\"Where the file is: in the flash of a board; next to the program on a PC or in the simulator.\"\"\"\n    if sys.platform in (\"linux\", \"darwin\", \"win32\"):\n        return \"cac_settings.json\"\n    try:\n        if \"flash\" in os.listdir(\"/\"):\n            return \"/flash/cac_settings.json\"\n    except OSError:\n        pass\n    return \"/cac_settings.json\"\n\n\ndef load():\n    \"\"\"The settings, or empty ones when the file is missing or broken.\"\"\"\n    try:\n        with open(path()) as f:\n            data = json.load(f)\n    except (OSError, ValueError):\n        data = {}\n    if not isinstance(data, dict):\n        data = {}\n    networks = [n for n in data.get(\"wifi\", []) if isinstance(n, dict) and n.get(\"ssid\")]\n    data[\"wifi\"] = networks[:MAX_NETWORKS]\n    data[\"version\"] = VERSION\n    return data\n\n\ndef save(data):\n    \"\"\"Write the settings whole: first a new file, then the rename, so a reset never leaves half.\"\"\"\n    name = path()\n    temporary = name + \".new\"\n    with open(temporary, \"w\") as f:\n        json.dump(data, f)\n    try:\n        os.remove(name)\n    except OSError:\n        pass\n    os.rename(temporary, name)\n\n\ndef section(name):\n    \"\"\"One section of other settings, such as \"display\": a dict, empty when there is none.\"\"\"\n    value = load().get(name)\n    return value if isinstance(value, dict) else {}\n\n\ndef set_section(name, value):\n    \"\"\"Replace one section; the networks and the other sections stay.\"\"\"\n    data = load()\n    data[name] = value\n    save(data)\n\n\nLANGUAGES = (\"en\", \"it\")\n\n\ndef language():\n    \"\"\"The language chosen in Settings for every app: \"en\" or \"it\", English when none.\"\"\"\n    code = section(\"general\").get(\"language\")\n    return code if code in LANGUAGES else \"en\"\n\n\ndef translator(italian):\n    \"\"\"t(text): the English text, or its Italian from the dict italian when the board speaks Italian.\"\"\"\n    if language() != \"it\":\n        return lambda text: text\n    return lambda text: italian.get(text, text)\n\n\ndef translate(ui, italian):\n    \"\"\"The texts of the widgets of ui, written in English in the designer, in the board's language.\n\n    italian maps each English text to its Italian: the text of a label, a button or a checkbox,\n    the options of a dropdown or a roller, the placeholder of a text area.\"\"\"\n    if language() != \"it\":\n        return\n    import lvgl as lv\n\n    for name in dir(ui):\n        o = getattr(ui, name)\n        try:\n            if isinstance(o, (lv.dropdown, lv.roller)):\n                text = italian.get(o.get_options())\n                if text is not None:\n                    o.set_options(text) if isinstance(o, lv.dropdown) else o.set_options(text, lv.roller.MODE.NORMAL)\n            elif isinstance(o, lv.textarea):\n                text = italian.get(o.get_placeholder_text())\n                if text is not None:\n                    o.set_placeholder_text(text)\n            elif isinstance(o, (lv.label, lv.checkbox)):\n                text = italian.get(o.get_text())\n                if text is not None:\n                    o.set_text(text)\n            elif isinstance(o, lv.button) and o.get_child_count():\n                label = o.get_child(0)\n                if isinstance(label, lv.label):\n                    text = italian.get(label.get_text())\n                    if text is not None:\n                        label.set_text(text)\n        except (AttributeError, TypeError):\n            pass\n\n\ndef networks():\n    \"\"\"The saved networks, from the most recently used: a list of {\"ssid\", \"password\"}.\"\"\"\n    return load()[\"wifi\"]\n\n\ndef password(ssid):\n    for item in networks():\n        if item[\"ssid\"] == ssid:\n            return item[\"password\"]\n    return None\n\n\ndef remember(ssid, password):\n    \"\"\"Save a network, or its new password, as the most recently used; the oldest goes when full.\"\"\"\n    data = load()\n    others = [n for n in data[\"wifi\"] if n[\"ssid\"] != ssid]\n    data[\"wifi\"] = ([{\"ssid\": ssid, \"password\": password}] + others)[:MAX_NETWORKS]\n    save(data)\n\n\ndef forget(ssid):\n    data = load()\n    data[\"wifi\"] = [n for n in data[\"wifi\"] if n[\"ssid\"] != ssid]\n    save(data)\n\n\ndef station():\n    \"\"\"The WiFi station interface, active, or None without WiFi hardware.\"\"\"\n    if network is None:\n        return None\n    try:\n        sta = network.WLAN(network.STA_IF)\n        sta.active(True)\n        return sta\n    except (AttributeError, OSError):\n        return None\n\n\ndef scan(sta=None):\n    \"\"\"The networks in range, strongest first, as (ssid, rssi); demo names without WiFi hardware.\"\"\"\n    sta = sta or station()\n    if sta is None:\n        return list(DEMO_SCAN)\n    best = {}\n    for entry in sta.scan():\n        try:\n            name = entry[0].decode()\n        except ValueError:\n            continue\n        if name and (name not in best or entry[3] > best[name]):\n            best[name] = entry[3]\n    return sorted(best.items(), key=lambda item: -item[1])\n\n\ndef connected_ssid(sta=None):\n    sta = sta or station()\n    if sta is None or not sta.isconnected():\n        return None\n    try:\n        return sta.config(\"essid\")\n    except (OSError, ValueError):\n        return \"?\"\n\n\ndef join(ssid, password, sta=None, timeout_s=TIMEOUT_S):\n    \"\"\"Connect to one network; True when connected within timeout_s.\"\"\"\n    sta = sta or station()\n    if sta is None:\n        return False\n    try:\n        sta.disconnect()\n    except OSError:\n        pass\n    try:\n        sta.connect(ssid, password)\n    except OSError as e:\n        print(\"cac_settings: connect\", ssid, repr(e))\n        return False\n    start = time.ticks_ms()\n    while not sta.isconnected():\n        if time.ticks_diff(time.ticks_ms(), start) > timeout_s * 1000:\n            try:\n                sta.disconnect()\n            except OSError:\n                pass\n            return False\n        time.sleep_ms(100)\n    return True\n\n\ndef connect(sta=None, timeout_s=TIMEOUT_S):\n    \"\"\"Connect to the best saved network in range and return its name, or None.\n\n    Already connected: nothing to do. Otherwise the saved networks found by a scan are tried, the\n    most recently used first and then by signal; the one that works becomes the most recent.\n    Networks that do not answer the scan are not tried: hidden networks are not supported.\"\"\"\n    sta = sta or station()\n    if sta is None:\n        return None\n    current = connected_ssid(sta)\n    if current:\n        return current\n    saved = networks()\n    if not saved:\n        return None\n    try:\n        visible = dict(scan(sta))\n    except OSError as e:\n        print(\"cac_settings: scan\", repr(e))\n        return None\n    candidates = [n for n in saved if n[\"ssid\"] in visible]\n    if len(candidates) > 1:\n        first, rest = candidates[0], candidates[1:]\n        candidates = [first] + sorted(rest, key=lambda n: -visible[n[\"ssid\"]])\n    for item in candidates:\n        if join(item[\"ssid\"], item[\"password\"], sta, timeout_s):\n            if item is not saved[0]:\n                remember(item[\"ssid\"], item[\"password\"])\n            print(\"cac_settings: connected to\", item[\"ssid\"], sta.ifconfig()[0])\n            return item[\"ssid\"]\n    return None\n"
    }
  ]
}
